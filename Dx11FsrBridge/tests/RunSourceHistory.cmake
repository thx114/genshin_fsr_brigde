# 退出后读取异步日志；不把文件流尚未 flush 当作生产状态失败。
execute_process(COMMAND "${HOST}" "${MODE}" "${BRIDGE}" "${PROVIDER}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
message("${output}${errors}")
if(NOT status EQUAL 0)
    message(FATAL_ERROR "History host failed: ${status}")
endif()
string(REGEX MATCH "History fixture root: ([^\r\n]+)" matched "${output}")
if(NOT matched)
    message(FATAL_ERROR "History host did not identify its isolated evidence directory")
endif()
file(READ "${CMAKE_MATCH_1}/Dx11FsrBridge.log" log)
if(NOT log MATCHES "before_sr_producer_bindings")
    message(FATAL_ERROR "Independent automatic producer did not complete")
endif()
if(MODE STREQUAL "ngx-history-file-failure")
    if(NOT log MATCHES "source_history_window export color=failed motion=ok")
        message(FATAL_ERROR "Real file failure was not reported as failed")
    endif()
else()
    if(NOT log MATCHES "source_history_window export color=ok motion=ok" OR
       NOT log MATCHES "source_history_window expired at Present;")
        message(FATAL_ERROR "Successful export or no-SDK Present expiration missing")
    endif()
endif()
